{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Test FizzBuzz",
            "type": "process",
            "command": "mvn",
            "args": [
                "-Dtest=FizzBuzzTest",
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Test all examples",
            "type": "process",
            "command": "mvn",
            "args": [
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}
